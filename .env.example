# Payment Gateways (optional - simulated escrow in demo mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# Supabase Auth (optional)
NEXT_PUBLIC_SUPABASE_URL=""
